# Find these in https://sanity.io/manage (or run `npx sanity init`)
PUBLIC_SANITY_PROJECT_ID="your-project-id"
PUBLIC_SANITY_DATASET="production"

# Date in YYYY-MM-DD form. Bump this when you want the newest API features.
PUBLIC_SANITY_API_VERSION="2024-10-01"

# Only if the dataset is PRIVATE: a "Viewer" token, read at build time.
# Server-only (no PUBLIC_ prefix on purpose). Public datasets need nothing.
# SANITY_API_READ_TOKEN="your-read-token"

# Public origin for canonicals / og:url / sitemap. Optional on Vercel, Netlify
# and Cloudflare Pages (falls back to the deploy URL). Delete it rather than
# leaving it empty.
# PUBLIC_SITE_URL="https://example.com"

# Editor chat (server side only — never PUBLIC_). Set these in the HOSTING's
# environment variables (Vercel / Netlify / Cloudflare Pages); in .env only to
# try the chat with `npm run dev`. Keys never reach the browser.
# One key per provider — the chat's model picker offers every provider with a key:
# ANTHROPIC_API_KEY="..."
# OPENAI_API_KEY="..."
# OPENROUTER_API_KEY="..."
# Optional allow-list for the picker (the agency caps cost here; first = default):
# AI_MODELS="anthropic:claude-sonnet-5-5, anthropic:claude-haiku-5-5, openai:gpt-4.1-mini"
# Add "sanity" to AI_MODELS to offer Sanity Agent Actions (no key; Sanity AI credits).
