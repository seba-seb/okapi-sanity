---
/**
 * Brings PageBuilder islands to life. Put it once at the end of the <body> of
 * every layout that renders <PageBuilder islands … />. Pages are plain HTML;
 * React + the blocks load only if the page has a section that needs JS.
 */
---

{import.meta.env.DEV && (
  // Dev only: Astro installs React's Fast Refresh preamble only for client:*
  // islands; ours (hydrate.tsx) need it too or .tsx modules throw.
  <script type="module" is:inline>
    import RefreshRuntime from "/@react-refresh";
    RefreshRuntime.injectIntoGlobalHook(window);
    window.$RefreshReg$ = () => {};
    window.$RefreshSig$ = () => (type) => type;
    window.__vite_plugin_react_preamble_installed__ = true;
  </script>
)}
<script>
  // Module scripts run once per document; with <ClientRouter /> later soft
  // navigations only fire astro:page-load, so check again on each one.
  const load = () => document.querySelector("[data-island]") && import("@/core/render/hydrate");
  load();
  document.addEventListener("astro:page-load", load);
</script>
