---
import "@/theme/globals.css";
import { urlForImage } from "@/core/sanity/image";
import { clean } from "@/core/lib/clean";
import { pageHref, resolveLink } from "@/core/lib/routes";
import { SiteHeader } from "@/chrome/SiteHeader";
import { SiteFooter } from "@/chrome/SiteFooter";
import Islands from "@/core/render/Islands.astro";
import type { Site } from "@/core/sanity/site";
import type { SanityImage } from "@/core/lib/types";

type Meta = {
  title?: string;
  metaTitle?: string;
  metaDescription?: string;
  ogImage?: SanityImage;
  slug?: { current?: string };
  noindex?: boolean;
} | null;

interface Props {
  site: Site;
  meta?: Meta;
}

const { site, meta } = Astro.props;
const { settings, navigation, routes } = site;

// Every SEO value is optional in the CMS and falls back: page → settings → code.
const siteName = clean(settings?.siteName) || "Untitled site";
const pageTitle = clean(meta?.metaTitle || meta?.title);
// The home page's title stands alone (it usually already carries the brand).
const isHome = meta?.slug?.current === "home";
const title = pageTitle ? (isHome ? pageTitle : `${pageTitle} · ${siteName}`) : siteName;
const description = clean(meta?.metaDescription || settings?.description) || undefined;
const ogSource = meta?.ogImage?.asset ? meta.ogImage : settings?.ogImage?.asset ? settings.ogImage : null;
const ogImage = ogSource ? urlForImage(ogSource).width(1200).height(630).fit("crop").url() : undefined;
const chrome = { navigation, settings, routes };

// Canonical = the public URL of this page.
const canonical = meta?.slug?.current
  ? new URL(pageHref(clean(meta.slug.current)), Astro.site).href
  : undefined;
const noindex = !!meta?.noindex;
const jsonLd = isHome
  ? {
      "@context": "https://schema.org",
      "@type": "Organization",
      name: siteName,
      url: Astro.site?.origin,
      sameAs: (settings?.socialLinks ?? [])
        .map((item) => resolveLink(clean(item.link), routes)?.href)
        .filter((href): href is string => !!href && /^https?:/.test(href)),
    }
  : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="data:," />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {canonical && <link rel="canonical" href={canonical} />}
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    {noindex && <meta name="robots" content="noindex" />}
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")} />}
    <link rel="sitemap" href="/sitemap.xml" />
    <slot name="head" />
  </head>
  <body>
    <SiteHeader {...chrome} />
    <slot />
    <SiteFooter {...chrome} />
    <Islands />
  </body>
</html>
