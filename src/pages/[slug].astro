---
import type { GetStaticPaths } from "astro";

// Static even when the project runs output: "server".
export const prerender = true;

import Base from "@/layouts/Base.astro";
import { PageBuilder } from "@/core/render/PageBuilder";
import { loadQuery } from "@/core/sanity/client";
import { loadSite } from "@/core/sanity/site";
import { PAGE_QUERY } from "@/core/sanity/queries";
import type { Page } from "@/core/lib/types";
import { RESERVED_SLUGS } from "@/core/config";

export const getStaticPaths = (async () => {
  const { routes } = await loadSite();
  // Reserved = the project's own routes: [slug] would outrank its [...rest] routes and replace them.
  const slugs = Object.values(routes).filter((slug) => slug !== "home" && !RESERVED_SLUGS.includes(slug));
  return await Promise.all(
    slugs.map(async (slug) => ({
      params: { slug },
      props: { page: await loadQuery<Page>(PAGE_QUERY, { slug }) },
    })),
  );
}) satisfies GetStaticPaths;

const { slug } = Astro.params;
const { page } = Astro.props as { page: Page | null };
const site = await loadSite();
---

<Base site={site} meta={page}>
  {page && <PageBuilder islands page={page} routes={site.routes} components={site.components} />}
</Base>
