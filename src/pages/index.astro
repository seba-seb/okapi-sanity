---
import Base from "@/layouts/Base.astro";
import { PageBuilder } from "@/core/render/PageBuilder";
import { Welcome } from "@/core/render/Welcome";
import { loadQuery } from "@/core/sanity/client";
import { loadSite } from "@/core/sanity/site";
import { PAGE_QUERY } from "@/core/sanity/queries";
import type { Page } from "@/core/lib/types";

const params = { slug: "home" };
const [page, site] = await Promise.all([loadQuery<Page>(PAGE_QUERY, params), loadSite()]);
---

<Base site={site} meta={page}>
  {page
    ? <PageBuilder client:load page={page} query={PAGE_QUERY} params={params} routes={site.routes} />
    : <Welcome />}
</Base>
