# Security headers for Netlify and Cloudflare Pages (Vercel: vercel.json).
# The Studio and the editor canvas can only be framed by this same site.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/studio
  Content-Security-Policy: frame-ancestors 'self'
  X-Frame-Options: SAMEORIGIN
/studio/*
  Content-Security-Policy: frame-ancestors 'self'
  X-Frame-Options: SAMEORIGIN
/edit-canvas
  Content-Security-Policy: frame-ancestors 'self'
  X-Frame-Options: SAMEORIGIN
/edit-canvas/*
  Content-Security-Policy: frame-ancestors 'self'
  X-Frame-Options: SAMEORIGIN
